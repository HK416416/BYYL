int visited[10];
int graph[10][10];
int stack[100];
int top;

int dfs(int start, int n) {
  int current;
  int i;
  
  top = 0;
  stack[top] = start;
  visited[start] = 1;
  
  while (top >= 0) {
    current = stack[top];
    top = top - 1;
    
    i = 0;
    while (i < n) {
      if (graph[current][i] == 1 && visited[i] == 0) {
        top = top + 1;
        stack[top] = i;
        visited[i] = 1;
      }
      i = i + 1;
    }
  }

  return 0;
}

int main() {
  int i1;
  
  graph[0][1] = 1;
  graph[0][2] = 1;
  graph[1][3] = 1;
  graph[2][4] = 1;
  
  i1 = 0;
  while (i1 < 10) {
    visited[i1] = 0;
    i1 = i1 + 1;
  }
  
  dfs(0, 5);
  return 0;
}