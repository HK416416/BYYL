int visited[10];
int graph[10][10];
int queue[100];
int front;
int rear;

int bfs(int start, int n) {
  int current;
  int i;
  
  front = 0;
  rear = 0;
  queue[rear] = start;
  rear = rear + 1;
  visited[start] = 1;
  
  while (front < rear) {
    current = queue[front];
    front = front + 1;
    
    i = 0;
    while (i < n) {
      if (graph[current][i] == 1 && visited[i] == 0) {
        queue[rear] = i;
        rear = rear + 1;
        visited[i] = 1;
      }
      i = i + 1;
    }
  }

  return 0;
}

int main() {
  int i1;
  
  graph[0][1] = 1;
  graph[0][2] = 1;
  graph[1][3] = 1;
  graph[2][4] = 1;
  
  i1 = 0;
  while (i1 < 10) {
    visited[i1] = 0;
    i1 = i1 + 1;
  }
  
  bfs(0, 5);
  return 0;
}