
int main ()
{
    int r[4][4];
    int i = 0, j = 0;
    while (i < 4)
    {   
        j = 0;
        while (j < 4)
        {   
            if(j==0){
                r[i][j] = 0;
            }else{
                r[i][j] = j + r[i][j-1];
            }
            j = j + 1;
        }

        write (r[i][i]);
        i = i + 1;
    }
    return 0;
}
