/* new_test3: while循环 + 嵌套if-else + 一元运算 + 数组操作 */
int fib(int n)
{
    int a, b, k, t;
    if (n <= 1)
        return n;
    a = 0;
    b = 1;
    k = 2;
    while (k <= n)
    {
        t = a + b;
        a = b;
        b = t;
        k = k + 1;
    }
    return b;
}

int main()
{
    int idx, f;
    int arr[10];
    idx = 0;
    while (idx < 10)
    {
        f = fib(idx);
        arr[idx] = f;
        idx = idx + 1;
    }
    idx = 0;
    while (idx < 10)
    {
        write(arr[idx]);
        idx = idx + 1;
    }
    return 0;
}
