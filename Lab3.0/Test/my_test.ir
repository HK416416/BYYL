FUNCTION main :
DEC v1 64
t1 := #0
v2 := t1
t2 := #0
v3 := t2
LABEL label1 :
t3 := #4
IF v2 < t3 GOTO label2
GOTO label3
LABEL label2 :
t4 := #0
v3 := t4
LABEL label4 :
t5 := #4
IF v3 < t5 GOTO label5
GOTO label6
LABEL label5 :
t6 := #0
IF v3 == t6 GOTO label7
GOTO label8
LABEL label7 :
t7 := #0
t8 := v2 * #16
t9 := v1 + t8
t10 := v3 * #4
t11 := t9 + t10
*t11 := t7
GOTO label9
LABEL label8 :
t12 := v2 * #16
t13 := v1 + t12
t14 := #1
t15 := v3 - t14
t16 := t15 * #4
t17 := t13 + t16
t18 := *t17
t19 := v3 + t18
t20 := v2 * #16
t21 := v1 + t20
t22 := v3 * #4
t23 := t21 + t22
*t23 := t19
LABEL label9 :
t24 := #1
t25 := v3 + t24
v3 := t25
GOTO label4
LABEL label6 :
t26 := v2 * #16
t27 := v1 + t26
t28 := v2 * #4
t29 := t27 + t28
t30 := *t29
WRITE t30
t31 := #1
t32 := v2 + t31
v2 := t32
GOTO label1
LABEL label3 :
t33 := #0
RETURN t33
