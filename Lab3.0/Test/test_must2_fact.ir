FUNCTION fact :
PARAM v1
t1 := #1
IF v1 == t1 GOTO label1
GOTO label2
LABEL label1 :
RETURN v1
GOTO label3
LABEL label2 :
t2 := #1
t3 := v1 - t2
ARG t3
t4 := CALL fact
t5 := v1 * t4
RETURN t5
LABEL label3 :
FUNCTION main :
READ t6
v2 := t6
t7 := #1
IF v2 > t7 GOTO label4
GOTO label5
LABEL label4 :
ARG v2
t8 := CALL fact
v3 := t8
GOTO label6
LABEL label5 :
t9 := #1
v3 := t9
LABEL label6 :
WRITE v3
t10 := #0
RETURN t10
