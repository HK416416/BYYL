FUNCTION fact :
PARAM v1
t1 := #1
IF v1 == t1 GOTO label1
GOTO label2
LABEL label1 :
RETURN v1
GOTO label3
LABEL label2 :
t2 := #1
t3 := v1 - t2
ARG t3
t4 := CALL fact
t5 := v1 * t4
RETURN t5
LABEL label3 :
FUNCTION main :
READ t1
v2 := t1
t2 := #1
IF v2 > t2 GOTO label4
GOTO label5
LABEL label4 :
ARG v2
t3 := CALL fact
v3 := t3
GOTO label6
LABEL label5 :
t4 := #1
v3 := t4
LABEL label6 :
WRITE v3
t5 := #0
RETURN t5
