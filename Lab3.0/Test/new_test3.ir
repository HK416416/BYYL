FUNCTION fib :
PARAM v1
t1 := #1
IF v1 <= t1 GOTO label1
GOTO label2
LABEL label1 :
RETURN v1
LABEL label2 :
t2 := #0
v2 := t2
t3 := #1
v3 := t3
t4 := #2
v4 := t4
LABEL label3 :
IF v4 <= v1 GOTO label4
GOTO label5
LABEL label4 :
t5 := v2 + v3
v5 := t5
v2 := v3
v3 := v5
t6 := #1
t7 := v4 + t6
v4 := t7
GOTO label3
LABEL label5 :
RETURN v3
FUNCTION main :
DEC v8 40
t8 := #0
v6 := t8
LABEL label6 :
t9 := #10
IF v6 < t9 GOTO label7
GOTO label8
LABEL label7 :
ARG v6
t10 := CALL fib
v7 := t10
t11 := v6 * #4
t12 := v8 + t11
*t12 := v7
t13 := #1
t14 := v6 + t13
v6 := t14
GOTO label6
LABEL label8 :
t15 := #0
v6 := t15
LABEL label9 :
t16 := #10
IF v6 < t16 GOTO label10
GOTO label11
LABEL label10 :
t17 := v6 * #4
t18 := v8 + t17
t19 := *t18
WRITE t19
t20 := #1
t21 := v6 + t20
v6 := t21
GOTO label9
LABEL label11 :
t22 := #0
RETURN t22
