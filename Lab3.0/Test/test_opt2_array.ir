FUNCTION add :
PARAM v1
t1 := #0
t2 := t1 * #4
t3 := v1 + t2
t4 := #1
t5 := t4 * #4
t6 := v1 + t5
t7 := *t3
t8 := *t6
t9 := t7 + t8
RETURN t9
FUNCTION main :
DEC v2 8
DEC v3 8
t1 := #0
v4 := t1
t2 := #0
v5 := t2
LABEL label1 :
t3 := #2
IF v4 < t3 GOTO label2
GOTO label3
LABEL label2 :
LABEL label4 :
t4 := #2
IF v5 < t4 GOTO label5
GOTO label6
LABEL label5 :
t5 := v4 + v5
t6 := &v2
t7 := v5 * #4
t8 := t6 + t7
*t8 := t5
t9 := #1
t10 := v5 + t9
v5 := t10
GOTO label4
LABEL label6 :
ARG &v2
t11 := CALL add
t12 := &v3
t13 := #0
t14 := t13 * #4
t15 := t12 + t14
t16 := v4 * #4
t17 := t15 + t16
*t17 := t11
t18 := &v3
t19 := #0
t20 := t19 * #4
t21 := t18 + t20
t22 := v4 * #4
t23 := t21 + t22
t24 := *t23
WRITE t24
t25 := #1
t26 := v4 + t25
v4 := t26
t27 := #0
v5 := t27
GOTO label1
LABEL label3 :
t28 := #0
RETURN t28
