FUNCTION add :
PARAM v1
t1 := #0
t2 := t1 * #4
t3 := v1 + t2
t4 := #1
t5 := t4 * #4
t6 := v1 + t5
t7 := *t3
t8 := *t6
t9 := t7 + t8
RETURN t9
FUNCTION main :
DEC v2 8
DEC v3 8
t10 := #0
v4 := t10
t11 := #0
v5 := t11
LABEL label1 :
t12 := #2
IF v4 < t12 GOTO label2
GOTO label3
LABEL label2 :
LABEL label4 :
t13 := #2
IF v5 < t13 GOTO label5
GOTO label6
LABEL label5 :
t14 := v4 + v5
t15 := v5 * #4
t16 := v2 + t15
*t16 := t14
t17 := #1
t18 := v5 + t17
v5 := t18
GOTO label4
LABEL label6 :
ARG v2
t19 := CALL add
t20 := #0
t21 := t20 * #4
t22 := v3 + t21
t23 := v4 * #4
t24 := t22 + t23
*t24 := t19
t25 := #0
t26 := t25 * #4
t27 := v3 + t26
t28 := v4 * #4
t29 := t27 + t28
t30 := *t29
WRITE t30
t31 := #1
t32 := v4 + t31
v4 := t32
t33 := #0
v5 := t33
GOTO label1
LABEL label3 :
t34 := #0
RETURN t34
